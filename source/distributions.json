    },
    "coordinates": { "minKm": 0.3, "maxKm": 12, "validateWithinKm": 25, "src": "city centers: OpenStreetMap Nominatim (osm-nominatim); jitter radius: estimate" },
    "secondaryCategoryCountWeights": { "0": 0.25, "1": 0.4, "2": 0.25, "3": 0.1, "src": "estimate" },
