{
  "$comment": "Aggregate generator parameters per industry profile. Every number is either an aggregate figure from a public source cited in docs/distributions.md (key in 'src') or an estimate (src 'estimate'). No real business, review, reviewer, address, or phone is stored here or anywhere in this repo. scripts/generate.mjs draws from these deterministically: each draw is seeded by 'seed' + the row id, so values are stable across weekly rebuilds.",
  "version": "1.1.0",
  "seed": "birdeye-business-context/distributions/1.1",
  "profileFor": {
    "$comment": "Channel (CH-SLV) accounts and advertising-agency accounts use the agency profile; everyone else uses their industryId.",
    "channelSegment": "CH-SLV",
    "agencyIndustry": "advertising-agency",
    "agencyProfile": "agency"
  },
  "curation": {
    "$comment": "quickScenario accounts are hand-written demo stories; their reviews, ratings, replies, and photo counts are left exactly as authored. Every other account's review sample is reshaped from these distributions.",
    "reshapeQuickScenarioAccounts": false,
    "minLowStarReviewsPerAccount": 1,
    "minLowStarReviewsSrc": "estimate: demo floor so every account's Reviews inbox has at least one 1-2 star review to reply to"
  },
  "display": {
    "$comment": "Screen-facing vocabulary, kept in one place so design can change it without touching the generator. These settings were confirmed by Balaji K on 2026-10-21 (docs/distributions.md#design-decisions).",
    "sites": [ { "id": "google", "label": "Google" }, { "id": "facebook", "label": "Facebook" }, { "id": "yelp", "label": "Yelp" } ],
    "businessStatus": { "open": "Open", "temporarilyClosed": "Temporarily closed", "permanentlyClosed": "Permanently closed" },
    "listingUrlTemplate": "https://{site}.example.com/biz/{slug}",
    "attributeGroupsExcluded": [ "From the business" ],
    "attributeGroupsExcludedSrc": "Design decision (Balaji K, 2026-10-21): identity attributes (for example owner-identity badges) are left out so demo businesses make no identity claims on screen.",
    "ratingDecimals": 1
  },
  "common": {
    "siteShare": { "google": 0.81, "facebook": 0.1, "yelp": 0.09, "src": "google: birdeye-sor-2025; facebook/yelp split of the remaining 19%: estimate" },
    "siteListedProbability": { "google": 1, "facebook": 0.85, "yelp": 0.75, "src": "estimate (a site is always listed when the location has a sampled review there)" },
    "siteRatingOffset": { "google": 0, "facebook": 0.05, "yelp": -0.5, "src": "direction: raval-ftc-2024 (Google and Facebook ratings run higher than Yelp, most of all for low-quality businesses); size: estimate" },
    "listingReviewCountSigma": { "value": 1, "src": "estimate (log-normal spread around the published medians)" },
    "listingRatingSd": {
      "value": 0.18,
      "min": 3.6,
      "max": 5,
      "src": "estimate (feedback-guru-2025 reports only 2-4% of listings in these industries below 4.0). A perfect 5.0 target is allowed only up to 20 reviews; larger listings cap at 4.95 (estimate; feedback-guru-2025: 20-23% of listings are a perfect 5.0, mostly small ones).",
      "maxWhenOverReviews": { "reviews": 20, "max": 4.95 }
    },
    "otherSiteCountSigma": { "value": 0.5, "src": "estimate" },
    "listingPhotos": { "median": 11, "sigma": 1.34, "min": 1, "max": 400, "src": "brightlocal-gbp-insights-2019: median 11 photos (listings with 1+ photo), 6% have one photo, 24% have 2-5; sigma fitted to those two shares (estimate)" },
    "reviewPhotos": { "shareWithPhotos": 0.12, "countWeights": { "1": 0.6, "2": 0.25, "3": 0.1, "4": 0.05 }, "src": "estimate" },
    "reviewLengthMedianChars": {
      "1": 315,
      "2": 298,
      "3": 116,
      "4": 48,
      "5": 119,
      "src": "trustreviews-2026 (median length by star). The generator never emits rating-only reviews because demo screens need text (birdeye-sor-2025: 81% of reviews include a comment)."
    },
    "replyRateByStar": {
      "1": 0.9,
      "2": 0.9,
      "3": 0.8,
      "4": 0.7,
      "5": 0.72,
      "src": "overall level anchored to birdeye-sor-2026 (75.5% of reviews get a response); split by star: estimate (trustreviews-2026 shows unmanaged profiles reply to ~45-54%)"
    },
    "replyLagHours": {
      "$comment": "Share of replies posted within each bound, in hours after the review.",
      "buckets": [ { "maxHours": 4, "share": 0.2 }, { "maxHours": 24, "share": 0.35 }, { "maxHours": 72, "share": 0.25 }, { "maxHours": 168, "share": 0.15 }, { "maxHours": 336, "share": 0.05 } ],
      "src": "estimate; context: reviewtrackers-2022 (53% of reviewers expect a reply within 7 days, 1 in 3 within 3 days), reviewtrackers-2023 (industry average reply times of about 2-10 days; healthcare and legal about 4)"
    },
    "claimed": {
      "google": { "Active": 1, "Demo": 0.9, "Needs setup": 0.5, "Inactive": 0.8 },
      "facebook": { "Active": 0.85, "Demo": 0.8, "Needs setup": 0.4, "Inactive": 0.7 },
      "yelp": { "Active": 0.65, "Demo": 0.6, "Needs setup": 0.3, "Inactive": 0.5 },
      "verifiedIfClaimed": 0.95,
