{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/craft-birdeye/birdeye-business-context/kg-plan-b/v1/kg/schemas/users.schema.json",
  "title": "users",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "businessName",
    "domain",
    "users"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "businessName": {
      "type": "string",
      "const": "Lush Landscaping"
    },
    "domain": {
      "type": "string",
      "const": "lushlandscaping.com"
    },
    "users": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^usr-[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9.]+@lushlandscaping\\.example$"
          },
          "role": {
            "type": "string",
            "enum": [
              "Account Owner",
              "Admin",
              "Regional Manager",
              "Location Manager",
              "Viewer"
            ]
          },
          "locationIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^loc-[a-z0-9-]+$"
            }
          },
          "regionIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^grp-[a-z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
