{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/craft-birdeye/birdeye-business-context/kg-plan-b/v1/kg/schemas/relationships.schema.json",
  "title": "relationships",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "businessName",
    "domain",
    "relationships"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "businessName": {
      "type": "string",
      "const": "Lush Landscaping"
    },
    "domain": {
      "type": "string",
      "const": "lushlandscaping.com"
    },
    "relationships": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "from",
          "to",
          "forwardLabel",
          "reverseLabel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^rel-[a-z0-9-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "works-at",
              "belongs-to",
              "part-of",
              "department-of"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(loc|ppl|grp)-[a-z0-9-]+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(loc|ppl|grp)-[a-z0-9-]+$"
          },
          "forwardLabel": {
            "type": "string",
            "minLength": 1
          },
          "reverseLabel": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
