  "reviews": [
    {
      "id": "acct-saltwick-dental-rev-1",
      "number": 1,
      "accountId": "acct-saltwick-dental",
      "locationId": "acct-saltwick-dental-loc-1",
      "location": "Saltwick Dental - San Francisco (San Francisco, CA)",
      "site": "facebook",
      "rating": 5,
      "reviewer": "Orion Abernethy",
      "date": "2026-10-04T14:50:00Z",
      "text": "Asked for a second opinion after another office pushed hard for a veneer consult. Dr. Naomi Feld said I didn't need it yet and showed me why on the scan. An honest dentist is hard to find, and Saltwick Dental has one.",
      "photoCount": 0,
      "featured": true,
      "archived": false,
      "employeesMentioned": [
        "Dr. Naomi Feld"
      ],
      "employees": 1,
      "replyStatus": "edit",
      "reply": {
        "text": "Thanks so much, Orion! We'll pass this along to the whole Saltwick Dental team. See you next time.\n\nSaltwick Dental Collective",
        "author": "Saltwick Dental Collective",
        "date": "2026-10-05T04:55:00Z"
      }
    },
    {
      "id": "acct-saltwick-dental-rev-2",
      "number": 2,
      "accountId": "acct-saltwick-dental",
      "locationId": "acct-saltwick-dental-loc-2",
      "location": "Saltwick Dental - Oakland (Oakland, CA)",
      "site": "google",
      "rating": 5,
      "reviewer": "Paloma Hargrove",
      "date": "2026-09-20T15:05:00Z",
      "text": "Came in for a deep cleaning at the Oakland location. Rico explained each step before starting and checked in halfway through. We finished on time and my next visit was booked before I left.",
      "photoCount": 0,
      "featured": false,
      "archived": false,
      "employeesMentioned": [
        "Rico"
      ],
      "employees": 1,
      "replyStatus": "post"
    },
    {
      "id": "acct-saltwick-dental-rev-3",
      "number": 3,
      "accountId": "acct-saltwick-dental",
      "locationId": "acct-saltwick-dental-loc-3",
      "location": "Saltwick Dental - Berkeley (Berkeley, CA)",
      "site": "google",
      "rating": 5,
      "reviewer": "Reuben Oyelaran",
      "date": "2026-09-06T20:40:00Z",
      "text": "Dr. Arjun Patil has a way of making appointments feel unhurried. My a veneer consult ran longer than planned and nobody rushed me out of the chair. That's why I keep coming back to Saltwick Dental.",
      "photoCount": 0,
      "featured": false,
      "archived": false,
      "employeesMentioned": [
        "Dr. Arjun Patil"
      ],
      "employees": 1,
      "replyStatus": "edit",
      "reply": {
        "text": "Thank you for the kind words, Reuben. We're glad everything went smoothly and look forward to seeing you again.\n\nSaltwick Dental Collective",
        "author": "Saltwick Dental Collective",
        "date": "2026-09-07T01:45:00Z"
      }
    },
    {
      "id": "acct-saltwick-dental-rev-4",
      "number": 4,
      "accountId": "acct-saltwick-dental",
      "locationId": "acct-saltwick-dental-loc-4",
      "location": "Saltwick Dental - San Mateo (San Mateo, CA)",
      "site": "yelp",
      "rating": 4,
      "reviewer": "Sabine Valdivia",
      "date": "2026-08-23T21:55:00Z",
      "text": "Good experience with a hygiene recall at the San Mateo location. The team was organized and the final bill matched the estimate. The waiting room was crowded around 4 p.m., so book early if you can.",
      "photoCount": 0,
      "featured": false,
      "archived": false,
      "employeesMentioned": [],
      "employees": 0,
      "replyStatus": "edit",
      "reply": {
        "text": "Thanks so much, Sabine! We'll pass this along to the whole Saltwick Dental team. See you next time.\n\nSaltwick Dental Collective",
        "author": "Saltwick Dental Collective",
        "date": "2026-08-24T09:15:00Z"
      }
    },
    {
      "id": "acct-saltwick-dental-rev-5",
      "number": 5,
      "accountId": "acct-saltwick-dental",
      "locationId": "acct-saltwick-dental-loc-5",
      "location": "Saltwick Dental - Palo Alto (Palo Alto, CA)",
      "site": "facebook",
      "rating": 2,
      "reviewer": "Tobias Delgado",
      "date": "2026-08-09T18:30:00Z",
      "text": "Waited almost half an hour past my appointment at the Palo Alto location with no explanation. Dr. Naomi Feld was kind once I got back there, but the front desk should warn people when the schedule slips.",
      "photoCount": 0,
      "featured": false,
      "archived": false,
      "employeesMentioned": [
        "Dr. Naomi Feld"
      ],
      "employees": 1,
      "replyStatus": "edit",
      "reply": {
        "text": "Tobias, thank you for telling us, and we're sorry. This isn't the experience we want anyone to have with Saltwick Dental. A manager will reach out this week to make it right.\n\nSaltwick Dental Collective",
        "author": "Saltwick Dental Collective",
        "date": "2026-08-15T05:15:00Z"
      }
    },
    {
      "id": "acct-saltwick-dental-rev-6",
