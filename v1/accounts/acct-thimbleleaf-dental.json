      "number": 2,
      "accountId": "acct-thimbleleaf-dental",
      "locationId": "acct-thimbleleaf-dental-loc-1",
      "location": "Thimbleleaf Family Dental (Austin, TX)",
      "site": "yelp",
      "rating": 5,
      "reviewer": "Ezra Whitlow",
      "date": "2026-10-12T18:20:00Z",
      "text": "Found Thimbleleaf after my old practice was bought by a big group. The difference is obvious: same hygienist every visit, and Marcus at the front desk sorted out my insurance in one phone call.",
