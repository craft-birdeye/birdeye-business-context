      "location": "Thimbleleaf Family Dental (Austin, TX)",
      "site": "google",
      "rating": 4,
      "reviewer": "Natalie Cordero",
      "date": "2026-10-07T21:45:00Z",
      "text": "Got a same-day appointment for a chipped front tooth the week of my sister's wedding. Dr. Bose bonded it in 40 minutes and it matches perfectly. One star off because the shared parking lot with the taco place next door was packed at lunch.",
      "photoCount": 1,
      "featured": false,
      "archived": false,
      "employeesMentioned": [
        "Dr. Anika Bose"
      ],
      "employees": 1,
      "replyStatus": "edit",
      "reply": {
        "text": "Thanks so much, Natalie! We'll pass this along to the whole Thimbleleaf Family Dental team. See you next time.\n\nDr. Anika Bose and the Thimbleleaf team",
        "author": "Dr. Anika Bose and the Thimbleleaf team",
        "date": "2026-10-08T15:40:00Z"
      }
    },
    {
      "id": "acct-thimbleleaf-dental-rev-4",
