      "featured": false,
      "archived": false,
      "employeesMentioned": [],
      "employees": 0,
      "replyStatus": "edit",
      "reply": {
        "text": "Yvette, thank you for telling us, and we're sorry. This isn't the experience we want anyone to have with Treadmarsh Tire. A manager will reach out this week to make it right.\n\nTreadmarsh Tire & Auto",
        "author": "Treadmarsh Tire & Auto",
        "date": "2026-08-27T11:40:00Z"
      }
    },
